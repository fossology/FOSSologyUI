# following keys are required

#backend endpoint
NEXT_PUBLIC_SERVER_URL=localhost/repo/api/v2

#for enabling https for backend url
NEXT_PUBLIC_HTTPS=false

#length of the random string for login
TOKEN_NAME_LENGTH=40

#by default the scope for user is to write
TOKEN_SCOPE=write

#authorization token expiry days
TOKEN_EXPIRY_DAYS=2

# Docker platform for fossology server (use linux/amd64 for Apple Silicon compatibility)
DOCKER_PLATFORM=linux/amd64
